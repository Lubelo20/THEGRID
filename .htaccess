# ── The Grid Technologies — production .htaccess (Apache/cPanel) ──
# Deployed to public_html on rs62.cphost.co.za. The mockup staging copy
# uses its own noindex .htaccess — never copy this file to the mockup.

Options -Indexes
ServerSignature Off

# Canonical host: force HTTPS + www with a single 301 (no chains)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^thegridtech\.co\.za$ [NC]
RewriteRule ^ https://www.thegridtech.co.za%{REQUEST_URI} [R=301,L]

# Clean URLs: /work serves work.html; old .html URLs 301 to the clean form
# (REDIRECT_STATUS guard: empty on the browser's request, set after the
#  internal /work -> work.html rewrite, so the two rules can't loop)
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteRule ^([a-z0-9-]+)\.html$ /$1 [R=301,L]
# strip trailing slash on page URLs (keeps relative asset paths working)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/$ /$1 [R=301,L]
# internally map /work -> work.html when the file exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)$ $1.html [L]
</IfModule>

# Legacy WordPress URLs -> new pages (301, single hop)
RedirectMatch 301 ^/about-us/?$ /team
RedirectMatch 301 ^/contact-us/?$ /contact
RedirectMatch 301 ^/our-services/?$ /services

# Friendly error pages (no paths or stack traces)
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html

# Security headers
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Cross-Origin-Resource-Policy "same-origin"
# HSTS only once served over HTTPS (AutoSSL) — env guard keeps HTTP clean
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
# CSP: all scripts are external same-origin files; 'unsafe-inline' only for style attributes
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data:; media-src 'self'; frame-src https://maps.google.com https://www.google.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
Header unset X-Powered-By
</IfModule>

# Block dotfiles and non-web files if any slip into the docroot
<FilesMatch "^\.|\.(bak|log|sql|md|sh|py)$">
Require all denied
</FilesMatch>
<FilesMatch "^(404\.html|privacy\.html|robots\.txt|sitemap\.xml)$">
Require all granted
</FilesMatch>

# Compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType video/mp4 "access plus 30 days"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
